# Never commit .env. Numbered accounts have no fixed maximum.
# MODELS is an allowlist; omit to consider discovered models (still free-gated).
# QUOTA_GROUP identifies shared project/org/owner quotas; different keys aren't proof of independence.
# If ownership is unknown, omit groups so all accounts of that provider share capacity.
NTG_GATEWAY_KEY=replace-with-a-random-secret-at-least-32-characters

GEMINI_API_KEY_1=
GEMINI_1_MODELS=gemini-2.5-flash
GEMINI_1_QUOTA_GROUP=google-project-a
# Leave false until the provider dashboard confirms billing disabled / free tier.
GEMINI_1_FREE_VERIFIED=false

GROQ_API_KEY_1=
GROQ_1_MODELS=openai/gpt-oss-20b
GROQ_1_QUOTA_GROUP=groq-organization-a
GROQ_1_FREE_VERIFIED=false

OPENROUTER_API_KEY_1=
# Discovery admits only explicit :free IDs with all pricing fields zero.
# No free eligibility attestation required for these explicit zero-priced variants.
OPENROUTER_1_MODELS=
OPENROUTER_1_QUOTA_GROUP=openrouter-owner-a

CLOUDFLARE_API_KEY_1=
CLOUDFLARE_ACCOUNT_ID_1=
CLOUDFLARE_1_MODELS=@cf/meta/llama-3.1-8b-instruct-fp8
CLOUDFLARE_1_QUOTA_GROUP=cloudflare-account-a
CLOUDFLARE_1_FREE_VERIFIED=false

COHERE_API_KEY_1=
COHERE_1_MODELS=command-a-03-2025
COHERE_1_QUOTA_GROUP=cohere-organization-a
# Evaluation keys only; production keys are paid. Evaluation use restrictions apply.
COHERE_1_FREE_VERIFIED=false
